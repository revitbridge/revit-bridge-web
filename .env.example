# Copy to .env next to docker-compose.yml. Every value is optional; the host
# starts with none of them set, as a local host. Never commit .env.

# --- Deploy mode ---
# local (default): this machine only. The port must be published on loopback
# (BIND_ADDRESS below; the host refuses to start otherwise); there is no relay,
# no pairing and no admin password - changing packs and skills and reading logs
# needs none. The Revit add-in on this machine is reached over TCP. Open it as
# http://127.0.0.1:7860 or http://localhost:7860: requests through a proxy, to
# another host name, or changes from another origin's page are refused (403).
# cloud: a host other machines reach - also one behind a reverse proxy or tunnel.
# Paired add-ins over the WebSocket relay, the device list, and ADMIN_PASSWORD,
# which is then required (no start without).
DEPLOY_MODE=local

# --- Model (server-side defaults; browser headers override per request) ---
# Any OpenAI-compatible chat-completions endpoint. Leave empty to require
# every visitor to bring their own key on the Connect page. LLM_API_KEY is only
# ever sent to LLM_BASE_URL: a visitor who names another base URL must bring a key.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Allow browser-supplied http:// endpoints and loopback/private addresses (local
# models); otherwise https on a public address only. In models.yml it lets an
# entry's base_url be http:// to any host (http:// to loopback needs no switch there).
LLM_ALLOW_HTTP=0
# /api/chat and /api/v1/bridge/spec/confirm requests per minute per IP.
CHAT_RATE_LIMIT=30
# The chat runs in three roles - analyst, planner, supervisor - each with its own
# instructions, tools and model (README, "The chat's roles"). 1 runs it as one model
# loop instead, exactly as before the roles: the comparison baseline and the fallback.
LLM_SINGLE_MODEL=0

# --- Models by role (optional file) ---
# models.yml gives each role (analyst, planner, supervisor) an endpoint and a model;
# see models.example.yml. It holds no key: each entry names the environment variable
# that does (api_key_env), so put those variables here, e.g. LLM_API_KEY above or
# OTHER_API_KEY=... With the file, LLM_BASE_URL / LLM_MODEL / LLM_API_KEY are not used
# (unless the file names LLM_API_KEY); browser headers replace the planner's entry.
# Default: models.yml in DATA_DIR (./data/models.yml with docker-compose.yml); no file
# there = the LLM_* variables above, as before. Set MODELS_FILE only to read another
# path: the host then refuses to start when there is no file at it, as it does for
# a file that is not valid.
# MODELS_FILE=/app/config/models.yml

# --- Admin (cloud only, required there) ---
# The X-Admin-Token of pack and skill changes, interaction logs and the device
# list. Leave it empty on a local host: set, a local host refuses to start (it
# looks like a cloud host missing DEPLOY_MODE=cloud).
ADMIN_PASSWORD=

# --- Local Revit add-in (TCP) reachable from the container ---
REVIT_BRIDGE_HOST=host.docker.internal
REVIT_BRIDGE_PORT=18080
REVIT_BRIDGE_TOKEN=
REVIT_BRIDGE_TIMEOUT=60

# --- Paired add-ins over the WebSocket relay (cloud only) ---
# How many may be connected at once (default 20). Each add-in is paired from the
# Connect page ("pair a Revit"), so there is no pre-shared token to configure or
# mount: the device token and the browser key are created by the pairing and only
# their hashes are stored, under REVIT_BRIDGE_DATA_DIR/auth/devices.json.
# MAX_DEVICES=20
# The 0.1 slot variables (MAX_SLOTS, MCP_BRIDGE_REQUIRE_SLOT_TOKEN,
# MCP_BRIDGE_SLOT_TOKEN_*) are gone; the host refuses to start if one is set.

# --- Confirmations (read by the revit-bridge package) ---
# Seconds a token from /api/v1/bridge/spec/confirm stays redeemable.
# REVIT_BRIDGE_CONFIRM_TTL=600

# --- Addresses ---
# Host interface for the published port (loopback behind a reverse proxy).
# docker-compose.yml also passes it into the container: a local host refuses to
# start unless it is loopback (127.0.0.1, ::1). Only a cloud host may use 0.0.0.0.
BIND_ADDRESS=127.0.0.1
PORT=7860
# Interface the server listens on inside the container; docker-compose.yml pins it.
# HOST=0.0.0.0
# Cloud only: when the add-in relay is reached on another address than the page
# (e.g. a dedicated WebSocket host name); empty = derived from the page origin.
PUBLIC_WS_BASE=
# Cloud only - a local host refuses to start when it is set. Split deployment (SPA
# on a static host, API here): allow that origin and put a static config.json next
# to the SPA's index.html (frontend/public/config.example.json).
CORS_ORIGINS=
# Proxies whose X-Forwarded-* headers uvicorn trusts: the client address used by
# the rate limits and the logs. The image trusts 127.0.0.1 and Docker's bridge
# networks (172.16.0.0/12), which is where a reverse proxy on the Docker host comes
# from when the port is published on loopback (BIND_ADDRESS=127.0.0.1). Leave it
# unset for that setup. When BIND_ADDRESS is not loopback, set it: to your proxy's
# address, or to 127.0.0.1 with no proxy in front, so visitors cannot pick their
# own address. If `docker network inspect revit-bridge-web_default` shows a
# 192.168.x subnet, list its gateway here instead of 172.16.0.0/12.
# FORWARDED_ALLOW_IPS=127.0.0.1,172.16.0.0/12

# --- Storage ---
# The package's data root: user capability packs (your tools), usage.json and the
# evidence ledger. docker-compose.yml and the image pin it to /app/data (the ./data
# volume). Without a container (uv run revit-bridge-web) leave it unset: the package
# then uses its per-user directory (%LOCALAPPDATA%\revit-bridge on Windows,
# ~/.local/share/revit-bridge elsewhere), the same one its MCP server uses, so your
# tools are shared with Claude Code and the other coding frameworks.
# REVIT_BRIDGE_DATA_DIR=/app/data
# This host's files (skills, interaction logs); docker-compose.yml pins it too.
# DATA_DIR=/app/data
# Package overrides for two directories under the data root. In the container leave
# them unset - except REVIT_BRIDGE_CAPABILITIES_DIR=/shared/capabilities together with
# SHARED_CAPABILITIES_DIR below (docker-compose.yml has both lines, commented).
# REVIT_BRIDGE_CAPABILITIES_DIR=/app/data/capabilities
# REVIT_BRIDGE_EVIDENCE_DIR=/app/data/evidence
# docker-compose.yml only: this machine's tool directory, mounted at /shared/capabilities
# when you uncomment the two lines there (shares your tools with the MCP server).
# SHARED_CAPABILITIES_DIR=C:/Users/<you>/AppData/Local/revit-bridge/capabilities

# --- Skills ---
# Replaces the built-in skill directory (the revit-bridge wheel's skills/,
# laid out as revit-bridge/SKILL.md + references/) with a read-only directory
# mounted into the container. Keep the same layout to keep the same skill ids;
# point it at an empty directory to list no built-in skills at all. The Skills
# page lists and edits them; they are not part of the chat's prompt.
SKILLS_DIR=

# --- Guidance layers (read by the revit-bridge package) ---
# The lessons the workbench's compile check (POST /api/v1/bridge/check) adds to its
# reply, as the package's MCP server does. Company and project lesson directories
# mounted into the container; unset = none.
# The personal layer is REVIT_BRIDGE_DATA_DIR/guidance.
# REVIT_BRIDGE_GUIDANCE_COMPANY=/guidance/company
# REVIT_BRIDGE_GUIDANCE_PROJECT=/guidance/project
