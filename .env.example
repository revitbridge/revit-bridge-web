# Copy to .env next to docker-compose.yml. Every value is optional; the host
# starts with none of them set. Never commit .env.

# --- Model (server-side defaults; browser headers override per request) ---
# Any OpenAI-compatible chat-completions endpoint. Leave empty to require
# every visitor to bring their own key on the Connect page.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Allow browser-supplied http:// endpoints (local models); https only otherwise.
LLM_ALLOW_HTTP=0
# /api/chat and /api/v1/bridge/spec/confirm requests per minute per IP.
CHAT_RATE_LIMIT=30

# --- Admin (skill edits, interaction logs) ---
ADMIN_PASSWORD=

# --- Local Revit add-in (TCP) reachable from the container ---
REVIT_BRIDGE_HOST=host.docker.internal
REVIT_BRIDGE_PORT=18080
REVIT_BRIDGE_TOKEN=
REVIT_BRIDGE_TIMEOUT=60

# --- Paired add-ins over the WebSocket relay ---
# How many may be connected at once. Each add-in is paired from the Connect page
# ("pair a Revit"), so there is no pre-shared token to configure or mount: the
# device token and the browser key are created by the pairing and only their
# hashes are stored, under REVIT_BRIDGE_DATA_DIR/auth/devices.json.
MAX_DEVICES=20
# The 0.1 slot variables (MAX_SLOTS, MCP_BRIDGE_REQUIRE_SLOT_TOKEN,
# MCP_BRIDGE_SLOT_TOKEN_*) are gone; the host refuses to start if one is set.

# --- Addresses ---
# Host interface for the published port (loopback behind a reverse proxy).
BIND_ADDRESS=127.0.0.1
PORT=7860
# Only when the add-in relay is reached on another address than the page
# (e.g. a dedicated WebSocket host name); empty = derived from the page origin.
PUBLIC_WS_BASE=
# Split deployment (SPA on a static host, API here): allow that origin and put
# a static config.json next to the SPA's index.html (frontend/public/config.example.json).
CORS_ORIGINS=
# Proxies whose X-Forwarded-* headers uvicorn trusts (client IPs in logs).
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Storage ---
# The package's data root: user capability packs, usage.json and the evidence
# ledger. docker-compose.yml pins it to /app/data (the ./data volume).
REVIT_BRIDGE_DATA_DIR=/app/data

# --- Skills ---
# Replaces the built-in skill directory (the revit-bridge wheel's skills/,
# laid out as revit-bridge/SKILL.md + references/) with a read-only directory
# mounted into the container. Keep the same layout to keep the same skill ids;
# point it at an empty directory to list no built-in skills at all.
SKILLS_DIR=
